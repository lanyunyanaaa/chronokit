{
  "name": "chronokit",
  "version": "0.3.0",
  "description": "Open-source video timestamps & metadata toolbox",
  "main": "./out/main/index.js",
  "author": "ChronoKit contributors",
  "license": "MIT",
  "homepage": "https://github.com/chronokit/chronokit",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "electron-vite build",
    "icons": "electron scripts/gen-icons.mjs",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "dist": "node scripts/fetch-ffmpeg.mjs && electron-vite build && electron-builder --win",
    "dist:dir": "node scripts/fetch-ffmpeg.mjs && electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@tanstack/react-virtual": "^3.14.13",
    "antd": "^5.21.0",
    "dayjs": "^1.11.10",
    "i18next": "^23.15.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
